[Unit]
Description=Real-time Translator Hybrid Whisper Service (Wyoming Integration)
Requires=rt-hybrid-whisper.socket
After=network.target

[Service]
Type=simple
ExecStart=%h/.nix-profile/bin/python -m src.whisper.hybrid_whisper_service --socket-path %t/rt-hybrid-whisper.sock --use-wyoming --wyoming-host localhost --wyoming-port 10300
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
Also=rt-hybrid-whisper.socket
